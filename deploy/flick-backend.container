# Quadlet unit for the flick backend (rootless podman + systemd --user).
# Install: copy to ~/.config/containers/systemd/ then
#   systemctl --user daemon-reload && systemctl --user start flick-backend
# Requires: `loginctl enable-linger $USER` so it runs without an active login.
#
# Auto-update: the image comes from ghcr, published by release.yml on every v*
# tag (multi-arch: amd64 + arm64). Enable the timer once per host:
#   systemctl --user enable --now podman-auto-update.timer
# It then checks daily and restarts this unit only when the digest changed.
#   podman auto-update --dry-run   # show what would change
#   podman auto-update             # apply now
#   podman auto-update rollback    # revert to the previous image if it broke
# Pull-based: nothing inbound is required — no SSH exposure, no runner on the box.
[Unit]
Description=flick backend (hosted edition)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/one-more-refactor/flick-backend:latest
# Track the registry digest; podman-auto-update pulls and restarts on change.
# Pin to a version tag instead (e.g. :v0.9.0) to freeze this host.
AutoUpdate=registry
ContainerName=flick-backend
# Shared bridge so the flick-admin container can proxy /api to this one by
# name (see flick-admin's deploy/flick.network).
Network=flick.network
# Loopback only — Cloudflare Tunnel reaches this; no public port is exposed.
PublishPort=127.0.0.1:3011:8484
Volume=flick-data:/data
Environment=FLICK_EDITION=hosted
Environment=FLICK_PUBLIC_URL=https://app.myflick.app
Environment=FLICK_ADDR=0.0.0.0:8484
Environment=FLICK_DATA_DIR=/data
# Set a real admin token on the host; keep it out of git.
Environment=FLICK_ADMIN_TOKEN=CHANGE_ME
# The admin panel (flick-admin, port 3013): the ADMIN link in the user app,
# and CORS only if the panel is served from its own origin un-proxied.
Environment=FLICK_ADMIN_URL=https://admin.myflick.app
# Environment=FLICK_ADMIN_ORIGIN=https://admin.myflick.app
# Email login codes are logged until SMTP is configured; password auth works today.
# Environment=FLICK_SMTP_URL=smtps://user:pass@smtp.host:465
# Environment=FLICK_SMTP_FROM=flick <no-reply@myflick.app>

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
