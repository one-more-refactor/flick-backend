# flick — production image: the API server with the web client bundled in.
#
# The Rust server is built from THIS repo; the Svelte client is fetched and
# built from flick-web, then baked in so the server serves it at "/". The API
# lives under /api. Native build — pick the host arch (arm64 on the prod box,
# amd64 on CI). No cross-compile, no QEMU.
#
#   podman build -t flick -f deploy/Containerfile .
#   # pin the client:  --build-arg WEB_REF=v0.9.0

ARG WEB_REPO=https://github.com/one-more-refactor/flick-web
ARG WEB_REF=master

# ---- web client (built from flick-web) ----------------------------------
FROM docker.io/oven/bun:1 AS web
ARG WEB_REPO
ARG WEB_REF
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /web
RUN git clone --depth 1 --branch "$WEB_REF" "$WEB_REPO" .
RUN bun install --frozen-lockfile || bun install
RUN bun run build

# ---- server (built from this repo) --------------------------------------
# rust:bookworm carries gcc, which rusqlite's bundled SQLite needs to compile.
FROM docker.io/library/rust:1-bookworm AS server
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY server/ server/
RUN cargo build --release -p flick-server

# ---- runtime ------------------------------------------------------------
FROM docker.io/library/debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# rustls everywhere (no OpenSSL); only CA roots are needed for outbound HTTPS.
WORKDIR /app
COPY --from=server /src/target/release/flick-server /usr/local/bin/flick-server
COPY --from=web /web/dist /app/web/dist
ENV FLICK_WEB_DIST=/app/web/dist \
    FLICK_DATA_DIR=/data \
    FLICK_ADDR=0.0.0.0:8484
RUN useradd --system --uid 10001 --home /app flick \
    && mkdir -p /data && chown flick:flick /data
USER flick
VOLUME ["/data"]
EXPOSE 8484
ENTRYPOINT ["/usr/local/bin/flick-server"]
